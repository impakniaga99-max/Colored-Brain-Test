          { color: 'G', ms: "Orang memberi maklum balas atas idea yang dizahirkan anda kepada mereka yang terlibat.", en: "People give you feedback on your ideas as you express them." },
          { color: 'R', ms: "Seseorang memberi penerangan yang panjang dan lengkap berkaitan sesuatu perkara.", en: "A person gives a long and complete explanation of the subject." },
          { color: 'P', ms: "Seseorang yang memberikan perincian berhubung sesuatu perkara di dalam bentuk butiran.", en: "Someone gives an itemized deliberation of the subject in bullet points." },
          { color: 'B', ms: "Pihak lain bersikap seperti mereka prihatin dengan apa yang saya katakan.", en: "The other person appears like they really care about what I'm talking about." }
        ]
      }
    ];

    const COLOR_PROFILES = {
      G: {
        title: 'HIJAU (Green - Chaotic / Random Processing)',
        shortName: 'HIJAU',
        bgClass: 'bg-brain-green',
        textClass: 'text-brain-green',
        borderClass: 'border-brain-green',
        traits: [
          'Nothing is connected (Pemprosesan tidak linear)',
          'Must act to understand (Perlu bertindak untuk faham)',
          'Need feedback (Perlu maklum balas)',
          'See big picture (Melihat gambaran besar)',
          'Find alternatives (Mencari alternatif)'
        ],
        description: 'Pemprosesan Hijau (Chaotic) berfungsi secara rawak, mengumpul maklumat dalam serpihan yang tidak berurutan. Anda cenderung untuk mengambil tindakan dengan cepat (Action First) berdasarkan pandangan "gambaran besar" dan memproses maklumat sambil berjalan. Anda sangat kreatif, spontan, dan gemar mencari penyelesaian alternatif.'
      },
      R: {
        title: 'MERAH (Red - Linear Processing)',
        shortName: 'MERAH',
        bgClass: 'bg-brain-red',
        textClass: 'text-brain-red',
        borderClass: 'border-brain-red',
        traits: [
          'Need clarity (Perlu kejelasan)',
          'Must see objective (Mesti melihat objektif)',
          'See logic (Melihat logik)',
          'Must analyze (Mesti menganalisis)',
          'Find structure (Mencari struktur)'
        ],
        description: 'Pemprosesan Merah (Linear) memerlukan kejelasan dan struktur. Anda memproses maklumat secara berurutan, menganalisis fakta dengan teliti, dan mencari logik yang objektif. Anda hanya mengambil tindakan selepas analisis mendalam, merancang untuk jangka panjang, dan mementingkan garis panduan yang jelas.'
      },
      B: {
        title: 'BIRU (Blue - Intuitive Processing)',
        shortName: 'BIRU',
        bgClass: 'bg-brain-blue',
        textClass: 'text-brain-blue',
        borderClass: 'border-brain-blue',
        traits: [
          'Everything is connected (Semua perkara berhubung)',
          'Feel environment (Merasai persekitaran)',
          'Insightful of surroundings (Berwawasan terhadap persekitaran)',
          'Multi-tasking (Multi-tugas)',
          'Intuitive of others (Intuitif terhadap orang lain)'
        ],
        description: 'Pemprosesan Biru (Intuitive) menghubungkan semua perkara, termasuk emosi dan pengalaman lalu, untuk membentuk gerak hati. Anda sangat berempati, peka terhadap perasaan orang lain, dan memahami dinamik persekitaran sosial. Komunikasi berkesan bagi anda memerlukan hubungan peribadi dan keikhlasan.'
      },
      P: {
        title: 'UNGU (Purple - Relational Processing)',
        shortName: 'UNGU',
        bgClass: 'bg-brain-purple',
        textClass: 'text-brain-purple',
        borderClass: 'border-brain-purple',
        traits: [
          'Must have information (Mesti ada maklumat)',
          'All data is linked (Semua data dipautkan)',
          'Need details (Perlu perincian)',
          'Find system (Mencari sistem)',
          'Find options (Mencari pilihan)'
        ],
        description: 'Pemprosesan Ungu (Relational) menjadikan maklumat sebagai keutamaan. Anda memerlukan data yang lengkap dan terperinci untuk melihat bagaimana setiap bahagian saling berkait. Anda mengambil masa untuk membuat keputusan bagi memastikan prosesnya sistematik, teratur, dan mempunyai pelan pelaksanaan yang praktikal.'
      }
    };

    function renderQuestions() {
      const container1A = document.getElementById('questions-1a');
      const container1B = document.getElementById('questions-1b');

      QUIZ_DATA.forEach((q) => {
        const questionCard = document.createElement('div');
        questionCard.id = `question-block-${q.id}`;
        questionCard.className = 'p-5 md:p-6 bg-slate-50/80 rounded-2xl border border-slate-200/80 transition-all';

        const optionsHTML = q.options.map((opt) => `
          <label class="block cursor-pointer group">
            <input type="radio" name="q${q.id}" value="${opt.color}" class="sr-only" onchange="handleAnswerChange()">
            <div class="choice-card p-4 bg-white border-2 border-slate-200 rounded-xl group-hover:border-blue-300 flex items-start space-x-3.5">
              <div class="radio-indicator w-5 h-5 mt-0.5 rounded-full border-2 border-slate-300 flex items-center justify-center shrink-0 transition-colors"></div>
              <div class="flex-1">
                <p class="font-semibold text-slate-800 text-sm md:text-base leading-snug">${opt.ms}</p>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">${opt.en}</p>
              </div>
            </div>
          </label>
        `).join('');

        questionCard.innerHTML = `
          <div class="mb-4">
            <h3 class="text-base md:text-lg font-bold text-slate-800 leading-snug">
              <span class="text-blue-600 mr-1">${q.id}.</span> ${q.ms}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 mt-1">${q.en}</p>
          </div>
          <div class="space-y-3">
            ${optionsHTML}
          </div>
        `;

        if (q.section === '1a') {
          container1A.appendChild(questionCard);
        } else {
          container1B.appendChild(questionCard);
        }
      });
    }

    function handleAnswerChange() {
      const scores1a = { G: 0, R: 0, P: 0, B: 0 };
      const scores1b = { G: 0, R: 0, P: 0, B: 0 };
      let answeredCount = 0;

      QUIZ_DATA.forEach((q) => {
        const selected = document.querySelector(`input[name="q${q.id}"]:checked`);
        const block = document.getElementById(`question-block-${q.id}`);

        if (selected) {
          answeredCount++;
          block.classList.remove('ring-2', 'ring-red-400', 'bg-red-50/40');

          if (q.section === '1a') {
            scores1a[selected.value] += 10;
          } else {
            scores1b[selected.value] += 10;
          }
        }
      });

      const percentage = Math.round((answeredCount / QUIZ_DATA.length) * 100);
      document.getElementById('progress-text').textContent = `${answeredCount} / ${QUIZ_DATA.length}`;
      document.getElementById('progress-bar').style.width = `${percentage}%`;

      ['G', 'R', 'P', 'B'].forEach(color => {
        document.getElementById(`score-${color}-1a`).textContent = scores1a[color];
        document.getElementById(`score-${color}-1b`).textContent = scores1b[color];
      });

      const total1a = Object.values(scores1a).reduce((a, b) => a + b, 0);
      const total1b = Object.values(scores1b).reduce((a, b) => a + b, 0);
      document.getElementById('total-1a').textContent = total1a;
      document.getElementById('total-1b').textContent = total1b;

      if (answeredCount === QUIZ_DATA.length) {
        document.getElementById('status-banner').classList.add('hidden');
      }
    }

    function calculateResults() {
      const statusBanner = document.getElementById('status-banner');
      const statusMessage = document.getElementById('status-message');
      let firstUnansweredBlock = null;
      let answeredCount = 0;
      const finalScores = { G: 0, R: 0, P: 0, B: 0 };

      QUIZ_DATA.forEach((q) => {
        const selected = document.querySelector(`input[name="q${q.id}"]:checked`);
        const block = document.getElementById(`question-block-${q.id}`);

        if (selected) {
          answeredCount++;
          finalScores[selected.value] += 10;
        } else {
          block.classList.add('ring-2', 'ring-red-400', 'bg-red-50/40');
          if (!firstUnansweredBlock) {
            firstUnansweredBlock = block;
          }
        }
      });

      if (answeredCount < QUIZ_DATA.length) {
        statusMessage.textContent = `Sila lengkapkan semua soalan sebelum mengira keputusan. Anda telah menjawab ${answeredCount} daripada ${QUIZ_DATA.length} soalan.`;
        statusBanner.classList.remove('hidden');
        if (firstUnansweredBlock) {
          firstUnansweredBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      statusBanner.classList.add('hidden');

      const sortedResults = Object.keys(finalScores)
        .map(key => ({ key, score: finalScores[key] }))
        .sort((a, b) => b.score - a.score);

      const maxScore = sortedResults[0].score;
      const topColors = sortedResults.filter(item => item.score === maxScore);
      const userName = document.getElementById('user-name').value.trim() || 'Peserta';

      // Dominant card
      const dominantCard = document.getElementById('dominant-card');
      if (topColors.length > 1 || maxScore < 40) {
        const tiedNames = topColors.map(c => COLOR_PROFILES[c.key].shortName).join(' & ');
        dominantCard.innerHTML = `
          <p class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-1">Profil Pemikiran ${userName}</p>
          <h3 class="text-3xl md:text-4xl font-black text-slate-800 mb-3">Fleksibiliti Tinggi (${tiedNames})</h3>
          <p class="text-slate-600 max-w-2xl mx-auto leading-relaxed">
            Anda menunjukkan keseimbangan dan fleksibiliti yang tinggi merentasi gaya pemprosesan yang berbeza. Anda mampu menyesuaikan cara anda berfikir, berkomunikasi, dan menyelesaikan masalah mengikut keperluan situasi semasa.
          </p>
        `;
      } else {
        const domProfile = COLOR_PROFILES[topColors[0].key];
        dominantCard.innerHTML = `
          <p class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-1">${userName}, Warna Otak Dominan Anda Ialah</p>
          <div class="my-3">
            <span class="text-5xl md:text-6xl font-black tracking-tight ${domProfile.textClass}">
              ${domProfile.shortName}
            </span>
          </div>
          <p class="text-slate-600 max-w-2xl mx-auto leading-relaxed mt-4">
            ${domProfile.description}
          </p>
        `;
      }

      // Final scores grid
      const scoresGrid = document.getElementById('final-scores-grid');
      scoresGrid.innerHTML = ['G', 'R', 'P', 'B'].map(colorKey => {
        const profile = COLOR_PROFILES[colorKey];
        const score = finalScores[colorKey];
        const isTop = score === maxScore;
        return `
          <div class="p-5 rounded-2xl ${profile.bgClass} text-white text-center shadow-md transition-transform ${isTop ? 'ring-4 ring-amber-300 scale-105' : 'opacity-90'}">
            <div class="text-3xl md:text-4xl font-black">${score}</div>
            <div class="text-xs font-bold uppercase tracking-wider mt-1 opacity-95">${profile.shortName}</div>
          </div>
        `;
      }).join('');

      // Detailed analysis
      const detailedAnalysis = document.getElementById('detailed-analysis');
      detailedAnalysis.innerHTML = sortedResults.map((item, idx) => {
        const profile = COLOR_PROFILES[item.key];
        const isHighest = idx === 0;
        return `
          <div class="p-6 rounded-2xl bg-white border-2 ${isHighest ? profile.borderClass + ' shadow-md' : 'border-slate-200'}">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <h4 class="text-lg md:text-xl font-extrabold ${profile.textClass}">
                ${profile.title}
              </h4>
              <span class="px-3 py-1 rounded-lg bg-slate-100 text-slate-800 font-extrabold text-sm">
                ${item.score} / 150 Mata
              </span>
            </div>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 my-4 text-sm text-slate-700">
              ${profile.traits.map(trait => `
                <li class="flex items-center space-x-2">
                  <span class="w-1.5 h-1.5 rounded-full ${profile.bgClass}"></span>
                  <span>${trait}</span>
                </li>
              `).join('')}
            </ul>
            <p class="text-sm text-slate-600 leading-relaxed pt-3 border-t border-slate-100">
              ${profile.description}
            </p>
          </div>
        `;
      }).join('');

      document.getElementById('quiz-container').classList.add('hidden');
      document.getElementById('results-container').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetQuiz() {
      document.querySelectorAll('input[type="radio"]').forEach(radio => {
        radio.checked = false;
      });
      handleAnswerChange();
      document.getElementById('results-container').classList.add('hidden');
      document.getElementById('quiz-container').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', renderQuestions);
  </script>
</body>
</html>