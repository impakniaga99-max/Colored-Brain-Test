  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: #f1f5f9;
      scroll-behavior: smooth;
    }
    .bg-brain-green { background-color: #10b981; }
    .bg-brain-red { background-color: #ef4444; }
    .bg-brain-purple { background-color: #8b5cf6; }
    .bg-brain-blue { background-color: #3b82f6; }
    .text-brain-green { color: #059669; }
    .text-brain-red { color: #dc2626; }
    .text-brain-purple { color: #7c3aed; }
    .text-brain-blue { color: #2563eb; }
    .border-brain-green { border-color: #10b981; }
    .border-brain-red { border-color: #ef4444; }
    .border-brain-purple { border-color: #8b5cf6; }
    .border-brain-blue { border-color: #3b82f6; }

    .choice-card {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    input[type="radio"]:checked + .choice-card {
      border-color: #2563eb;
      background-color: #eff6ff;
      box-shadow: 0 4px 12px -2px rgba(37, 99, 235, 0.15);
      transform: translateY(-1px);
    }
    input[type="radio"]:checked + .choice-card .radio-indicator {
      border-color: #2563eb;
      background-color: #2563eb;
    }
    input[type="radio"]:checked + .choice-card .radio-indicator::after {
      content: '';
      display: block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: white;
    }

    @keyframes slideUpFade {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-result {
      animation: slideUpFade 0.6s ease-out forwards;
    }
  </style>
</head>
